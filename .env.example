APP_USERNAME=interviewer
APP_PASSWORD_HASH=$$argon2id$$replace-with-hash
SESSION_SECRET=replace-with-a-long-random-string
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:3001/api/xero/callback
MODEL=openai:gpt-4.1-mini
OPENAI_API_KEY=
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
DATABASE_PATH=/app/data/app.db
ACTION_EXECUTION_TIMEOUT_SECONDS=120
CHAT_TIMEOUT_SECONDS=60
CHAT_REQUEST_LIMIT=12
CHAT_TOOL_LIMIT=12
CHAT_TOKEN_LIMIT=20000
CHAT_OUTPUT_LIMIT=2048
CHAT_PROMPT_CHARACTER_LIMIT=4000
CHAT_TEMPERATURE=0
AI_REQUEST_TIMEOUT_SECONDS=20
AI_PROVIDER_RETRIES=0
AI_VALIDATION_RETRIES=1
CHAT_SUMMARY_EVERY=10
SUMMARY_TIMEOUT_SECONDS=10
SUMMARY_REQUEST_LIMIT=2
SUMMARY_TOKEN_LIMIT=4000
SUMMARY_OUTPUT_LIMIT=768
SUMMARY_MAX_BLOCKS=1
HISTORY_MESSAGE_LIMIT=20
HISTORY_CHARACTER_LIMIT=12000
JEV_TIMEOUT_SECONDS=5
TRACE_SAMPLE_RATIO=0.1
ENVIRONMENT=development
PERFORMANCE_REPORTS_ENABLED=false
REPORT_TIMEOUT_SECONDS=30
